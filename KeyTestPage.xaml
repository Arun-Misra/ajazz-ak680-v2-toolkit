<Page x:Class="AK680V2Toolkit.KeyTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AK680V2Toolkit"
      Title="Key Test" Background="{StaticResource PageBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="Start monitoring" Click="Start_Click"/>
            <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Content="Stop" Margin="8,0,0,0" Click="Stop_Click" IsEnabled="False"/>
            <TextBlock x:Name="Status" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Green" Text="Idle"/>
        </StackPanel>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"
                   Text="Press physical keys. Each key shows its live Hall travel in millimetres and lights up as it is pressed. This uses the keyboard's internal key-test telemetry."/>
        <local:KeyboardView x:Name="Preview" Grid.Row="2" Height="320" ShowValues="True"/>
    </Grid>
</Page>
