<Page x:Class="AK680V2Toolkit.GamepadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hall Gamepad" Background="{StaticResource PageBg}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Hall Gamepad" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"
                           Text="Turns WASD into a virtual XInput stick. Analog intensity comes from each key's Hall travel, measured by the keyboard itself — not from Windows key events."/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="Start" Click="Start_Click"/>
                    <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Content="Stop" Margin="8,0,0,0" Click="Stop_Click" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="CalibrateButton" Style="{StaticResource GhostButton}" Content="Calibrate full travel" Margin="0,10,0,0"
                        Click="Calibrate_Click" IsEnabled="False"/>
                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Calibration: press each of W/A/S/D fully to the bottom once when prompted."/>

                <TextBlock Text="Mapping" FontWeight="Bold" Margin="0,18,0,4"/>
                <TextBlock Text="W → stick up    S → stick down&#x0a;A → stick left   D → stick right&#x0a;Stroke range 0–3.4 mm (0.01 mm units)" TextWrapping="Wrap"/>

                <TextBlock Text="Status" FontWeight="Bold" Margin="0,18,0,4"/>
                <TextBlock x:Name="Status" Foreground="Green" TextWrapping="Wrap" Text="Idle"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Live analog" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <Grid Width="150" Height="150">
                        <Ellipse Stroke="{StaticResource TextMuted}" StrokeThickness="2" Fill="#11000000"/>
                        <Line X1="75" Y1="5" X2="75" Y2="145" Stroke="#22000000"/>
                        <Line X1="5" Y1="75" X2="145" Y2="75" Stroke="#22000000"/>
                        <Ellipse x:Name="LeftDot" Width="18" Height="18" Fill="{StaticResource Accent}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="66,66,0,0"/>
                    </Grid>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LeftText" Text="LX  0.00   LY  0.00" FontFamily="Consolas" FontSize="14"/>
                        <TextBlock x:Name="StrokeText" Text="W 0   A 0   S 0   D 0" FontFamily="Consolas" FontSize="14" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Key travel (0–3.4 mm)" FontWeight="Bold" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/><RowDefinition Height="30"/>
                        <RowDefinition Height="30"/><RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBlock Text="W" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ProgressBar x:Name="WBar" Grid.Row="0" Grid.Column="1" Height="14" Maximum="100" Minimum="0"/>
                    <TextBlock x:Name="WVal" Grid.Row="0" Grid.Column="2" Text="0.00 mm" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="A" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ProgressBar x:Name="ABar" Grid.Row="1" Grid.Column="1" Height="14" Maximum="100" Minimum="0"/>
                    <TextBlock x:Name="AVal" Grid.Row="1" Grid.Column="2" Text="0.00 mm" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="S" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ProgressBar x:Name="SBar" Grid.Row="2" Grid.Column="1" Height="14" Maximum="100" Minimum="0"/>
                    <TextBlock x:Name="SVal" Grid.Row="2" Grid.Column="2" Text="0.00 mm" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="D" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ProgressBar x:Name="DBar" Grid.Row="3" Grid.Column="1" Height="14" Maximum="100" Minimum="0"/>
                    <TextBlock x:Name="DVal" Grid.Row="3" Grid.Column="2" Text="0.00 mm" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                </Grid>

                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"
                           Text="Requires the ViGEmBus driver (already installed on this machine). Games see a standard Xbox 360 controller."/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
