<Page x:Class="AK680V2Toolkit.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AK680V2Toolkit"
      Title="Performance" Background="{StaticResource PageBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource AccentButton}" Content="Custom" Margin="0,0,8,0"/>
            <Button Style="{StaticResource GhostButton}" Content="Office Mode" Margin="0,0,8,0"/>
            <Button Style="{StaticResource GhostButton}" Content="Beginner Mode" Margin="0,0,8,0"/>
            <Button Style="{StaticResource GhostButton}" Content="Game Mode"/>
        </StackPanel>

        <local:KeyboardView x:Name="Preview" Grid.Row="1" Height="250" ShowValues="True" Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TabControl>
                        <TabItem Header="Normal Mode">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource TextMuted}"
                                           Text="Per-key trigger point and actuation are shown on the keyboard above. Select keys to configure."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Content="Select All" Margin="0,0,16,0"/>
                                    <CheckBox Content="WASD" Margin="0,0,16,0"/>
                                    <CheckBox Content="Numeric keys" Margin="0,0,16,0"/>
                                    <CheckBox Content="Arrow keys" Margin="0,0,16,0"/>
                                    <CheckBox Content="Record"/>
                                </StackPanel>
                                <TextBlock Text="Trigger Distance" FontWeight="Bold" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="TriggerDistance" Minimum="2" Maximum="40" Value="12" Width="260"/>
                                    <TextBlock x:Name="TriggerLabel" Text="1.2mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Advanced Settings">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Fast Trigger" x:Name="FastTrigger" Margin="0,0,0,8"/>
                                <TextBlock Text="Release point" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ReleasePoint" Width="160" SelectedIndex="0">
                                    <ComboBoxItem Content="T1"/><ComboBoxItem Content="T2"/>
                                </ComboBox>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Switch Calibration">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Text="Calibrate the magnetic switches to match your key travel." Margin="0,0,0,12"/>
                                <Button Style="{StaticResource GhostButton}" Content="Start Calibration" HorizontalAlignment="Left" Click="Calibrate_Click"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Keyboard settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                    <CheckBox Content="Stability mode" x:Name="Stability" Margin="0,0,0,8"/>
                    <CheckBox Content="Adaptive dynamic calibration (Beta)" x:Name="Adaptive" Margin="0,0,0,12"/>
                    <TextBlock Text="Return rate" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ReturnRate" SelectedIndex="2">
                        <ComboBoxItem Content="1K Return Rate"/>
                        <ComboBoxItem Content="4K Return Rate"/>
                        <ComboBoxItem Content="8K Return Rate"/>
                    </ComboBox>
                    <Button Style="{StaticResource AccentButton}" Content="Apply settings" Margin="0,16,0,0" HorizontalAlignment="Left" Click="Apply_Click"/>
                    <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="Green"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
