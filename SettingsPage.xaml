<Page x:Class="AK680V2Toolkit.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings" Background="{DynamicResource PageBg}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                <ListBox x:Name="Sections" BorderThickness="0" SelectionChanged="Sections_SelectionChanged">
                    <ListBoxItem Content="Interface Settings" IsSelected="True" Tag="Interface"/>
                    <ListBoxItem Content="Keyboard Settings" Tag="Keyboard"/>
                    <ListBoxItem Content="Update" Tag="Update"/>
                </ListBox>
                <TextBlock x:Name="DeviceLabel" Text="AJAX AK680 V2 v1.11" Margin="0,24,0,0" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel x:Name="InterfacePanel">
                <TextBlock Text="Interface Theme" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="LightTheme" Content="Light Theme" IsChecked="True" Margin="0,0,16,0" Checked="Theme_Changed"/>
                    <RadioButton x:Name="DarkTheme" Content="Dark Theme" Margin="0,0,16,0" Checked="Theme_Changed"/>
                    <RadioButton x:Name="SyncTheme" Content="Sync theme with computer" Checked="Theme_Changed"/>
                </StackPanel>
                <TextBlock Text="Language" FontWeight="Bold" Margin="0,0,0,8"/>
                <ComboBox x:Name="LanguageCombo" Width="180" SelectedIndex="0" SelectionChanged="Language_SelectionChanged"/>

                <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed">
                    <TextBlock Text="Stability Mode" FontWeight="Bold" Margin="0,20,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"
                               Text="Enabling stability mode optimizes the key algorithm under extreme parameters."/>
                    <CheckBox x:Name="StabilityCheck" Content="Enable stability mode" Margin="0,0,0,16"/>
                    <TextBlock Text="Adaptive Dynamic Calibration (Beta)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="AdaptiveCheck" Content="Enable adaptive calibration" Margin="0,0,0,16"/>
                    <TextBlock Text="Return Rate" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ReturnRate" Width="180" SelectedIndex="2">
                        <ComboBoxItem Content="1K Return Rate"/>
                        <ComboBoxItem Content="4K Return Rate"/>
                        <ComboBoxItem Content="8K Return Rate"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Apply keyboard settings" Click="ApplyKeyboard_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Reset all keyboard settings" Margin="8,0,0,0" Click="ResetAll_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="UpdatePanel" Visibility="Collapsed">
                    <TextBlock Text="Update" FontWeight="Bold" FontSize="16" Margin="0,20,0,8"/>
                    <TextBlock x:Name="VersionLabel" Text="AJAZZ AK680 V2 v1.11" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SystemInfoLabel" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"
                               Text="Device system info not read yet."/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Style="{StaticResource GhostButton}" Content="Check device" Click="CheckUpdate_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Choose firmware…" Margin="8,0,0,0" Click="ChooseFirmware_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="FirmwarePath" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" Text="No firmware file selected"/>
                    <Button x:Name="FlashButton" Style="{StaticResource AccentButton}" Content="Verify and flash firmware" HorizontalAlignment="Left" Click="Flash_Click" IsEnabled="False"/>
                    <ProgressBar x:Name="FlashProgress" Height="16" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
                    <TextBlock x:Name="FlashStatus" TextWrapping="Wrap" Foreground="Green" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock x:Name="Status" Margin="0,20,0,0" Foreground="Green"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
