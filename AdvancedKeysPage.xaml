<Page x:Class="AK680V2Toolkit.AdvancedKeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AK680V2Toolkit"
      Title="Advanced Keys" Background="{StaticResource PageBg}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:KeyboardView x:Name="Preview" Height="230" Margin="0,0,0,8"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Advanced Keys" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12"
                               Text="First, select any key to bind advanced keys. Each configuration file can use up to 40 advanced keys. An advanced key cannot be added to multiple layers on a single key but can be bound on different layers."/>
                    <Border Background="#FAFAFA" CornerRadius="6" Padding="8" Margin="0,0,0,8" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="RS" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" Text="Rappy Snappy monitors the 2 selected keys and activates whichever key is pressed down further."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FAFAFA" CornerRadius="6" Padding="8" Margin="0,0,0,8" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="SOCD" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" Text="SOCD monitors the 2 selected keys and activates them based on your chosen settings."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FAFAFA" CornerRadius="6" Padding="8" Margin="0,0,0,8" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Dynamic Key Travel (DKS)" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" Text="A single key can achieve 4 functions: bind 1 to 4 functions based on different pressure levels."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FAFAFA" CornerRadius="6" Padding="8" Margin="0,0,0,8" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Dual Effect Click (MT)" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" Text="A single key can achieve 2 functions: holding the key is one function, clicking is another."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FAFAFA" CornerRadius="6" Padding="8" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Toggle Switch (TGL)" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" Text="Clicking the key toggles continuous triggering on or off. Holding the key triggers normally."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Current Bindings" FontSize="16" FontWeight="Bold"/>
                        <Border Background="#EEE" CornerRadius="4" Padding="4,2" Margin="8,0,0,0">
                            <TextBlock Text="0/40"/>
                        </Border>
                    </StackPanel>
                    <ListBox x:Name="BindingList" Margin="0,12,0,0" MinHeight="200"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Test Your Bindings" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Height="180"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>