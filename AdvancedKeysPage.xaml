<Page x:Class="AK680V2Toolkit.AdvancedKeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AK680V2Toolkit"
      Title="Advanced Keys" Background="{DynamicResource PageBg}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:KeyboardView x:Name="Preview" Height="230" Margin="0,0,0,8"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Advanced Keys" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"
                               Text="Select keys on the keyboard, choose an advanced type, then configure and save."/>
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="Type_Click" Tag="RS" Content="RS — Rappy Snappy (2 keys)"/>
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="Type_Click" Tag="SOCD" Content="SOCD — priority (2 keys)"/>
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="Type_Click" Tag="DKS" Content="DKS — dynamic travel (1 key)"/>
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,0,8" Click="Type_Click" Tag="MT" Content="MT — tap / hold (1 key)"/>
                    <Button Style="{StaticResource GhostButton}" Click="Type_Click" Tag="TGL" Content="TGL — toggle (1 key)"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="ConfigTitle" Text="Configuration" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="SelectedLabel" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,10" Text="No keys selected"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                        <StackPanel x:Name="ConfigPanel"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Current Bindings" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="BindingCount" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" Text="0/40"/>
                    <ListBox x:Name="BindingList" MinHeight="260"/>
                    <Button Style="{StaticResource GhostButton}" Content="Remove selected" Margin="0,10,0,0" Click="Remove_Click"/>
                    <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="Green" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
