<Page x:Class="AK680V2Toolkit.MacroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Shortcut Command" Background="{DynamicResource PageBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Input Record List" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Content="New" Click="New_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Delete" Margin="8,0,0,0" Click="Delete_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Import" Margin="8,0,0,0" Click="Import_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Export" Margin="8,0,0,0" Click="Export_Click"/>
                    <ComboBox x:Name="MacroCombo" Width="180" Margin="16,0,0,0" SelectionChanged="MacroCombo_SelectionChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Edit recording file" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                    <TextBlock Text="Action type" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ActionType" SelectedIndex="0">
                        <ComboBoxItem Content="Keyboard Input Action"/>
                        <ComboBoxItem Content="Mouse Input Action"/>
                    </ComboBox>
                    <TextBlock Text="Key code (0-255)" Margin="0,12,0,4"/>
                    <TextBox x:Name="KeyCode"/>
                    <TextBlock Text="Delay (ms)" Margin="0,12,0,4"/>
                    <TextBox x:Name="Delay" Text="10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="IsPress" Content="Press" IsChecked="True" Margin="0,0,12,0"/>
                        <CheckBox x:Name="RecordInterval" Content="Record interval" IsChecked="True"/>
                    </StackPanel>
                    <Button Style="{StaticResource AccentButton}" Content="Insert action" Margin="0,16,0,0" Click="Insert_Click"/>
                    <TextBlock Text="Record from physical keys" FontWeight="Bold" Margin="0,18,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"
                               Text="Press Start, type the sequence, then Stop. Key codes are the keyboard's HID usages; delays are captured between events."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartRecordButton" Style="{StaticResource AccentButton}" Content="Start recording" Click="StartRecording_Click"/>
                        <Button x:Name="StopRecordButton" Style="{StaticResource GhostButton}" Content="Stop" Margin="8,0,0,0" Click="StopRecording_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="RecordStatus" Margin="0,6,0,0" FontWeight="Bold" Foreground="#C0392B" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource GhostButton}" Content="Save to keyboard" Margin="0,12,0,0" Click="Save_Click"/>
                    <TextBlock x:Name="Status" Margin="0,12,0,0" Foreground="Green" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Action Record List" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ActionGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding KeyCode}" Width="100"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                            <DataGridTextColumn Header="Delay (ms)" Binding="{Binding Delay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
