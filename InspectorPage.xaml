<Page x:Class="AK680V2Toolkit.InspectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Device Inspector" Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Device Inspector" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"
                           Text="Reads every block the firmware answers and decodes it with the driver's layouts. Nothing is written to the keyboard."/>
                <Button Style="{StaticResource AccentButton}" Content="Read everything" Click="Read_Click"/>
                <Button Style="{StaticResource GhostButton}" Content="Save report" Margin="0,8,0,0" Click="Save_Click" IsEnabled="False" x:Name="SaveButton"/>
                <TextBlock Text="Status" FontWeight="Bold" Margin="0,18,0,4"/>
                <TextBlock x:Name="Status" Foreground="Green" TextWrapping="Wrap" Text="Idle"/>
                <TextBlock Text="Read commands" FontWeight="Bold" Margin="0,18,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12"
                           Text="Device info, game mode, LED effect, key matrix, custom LEDs, trigger points, rapid trigger, DKS, macro index, plus raw reply headers."/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="OverviewText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8" Text="No data yet."/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Keys &amp; LEDs">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="KeysText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Trigger &amp; RT">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RtText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="DKS &amp; macros">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DksText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Live RGB &amp; FN">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LiveText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Raw replies">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RawText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
