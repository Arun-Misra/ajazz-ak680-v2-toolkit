<Window x:Class="AK680V2Toolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AK680 V2 Toolkit" Height="720" Width="1100"
        Background="{DynamicResource PageBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource CardBg}" BorderBrush="#EFEFF5" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <Image Source="https://cp.driveall.cn/logo/ajazz/logo.png" Height="40" Margin="0,8,0,24"/>
                <TextBlock Text="AJAZZ AK680 V2" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusText" Text="Not connected" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                <Button Content="Refresh device" Style="{StaticResource GhostButton}" Margin="0,0,0,12" Click="RefreshDevice_Click"/>
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged" BorderThickness="0">
                    <ListBoxItem Content="Custom Keys" Tag="CustomKeys"/>
                    <ListBoxItem Content="Lighting Settings" Tag="Lighting"/>
                    <ListBoxItem Content="Shortcut Command" Tag="Macro"/>
                    <ListBoxItem Content="Performance" Tag="Performance"/>
                    <ListBoxItem Content="Advanced Keys" Tag="AdvancedKeys"/>
                    <ListBoxItem Content="Settings" Tag="Settings"/>
                    <ListBoxItem Content="Profiles" Tag="Profiles"/>
                    <ListBoxItem Content="Animations" Tag="Animations"/>
                    <ListBoxItem Content="Hall Gamepad" Tag="Gamepad"/>
                    <ListBoxItem Content="Device Inspector" Tag="Inspector"/>
                    <ListBoxItem Content="Key Test" Tag="KeyTest"/>
                    <ListBoxItem Content="Key Map Debug" Tag="Debug"/>
                </ListBox>
                <Separator Margin="0,16"/>
                <TextBlock Text="Keyboard Config File" FontWeight="Bold" Margin="0,4"/>
                <Button Content="Create File" Margin="0,4" Padding="8,4" Click="CreateFile_Click"/>
            <Button Content="Import files" Margin="0,4" Padding="8,4" Click="ImportFiles_Click"/>
                <TextBlock Text="profile" Foreground="{DynamicResource TextMuted}" Margin="0,4"/>
            </StackPanel>
        </Border>
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="12"/>
    </Grid>
</Window>