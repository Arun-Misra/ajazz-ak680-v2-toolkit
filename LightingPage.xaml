<Page x:Class="AK680V2Toolkit.LightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AK680V2Toolkit"
      Title="Lighting Settings" Background="{DynamicResource PageBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:KeyboardView x:Name="Preview" Height="230" Margin="0,0,0,10" KeyClicked="Preview_KeyClicked"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Lighting Effects" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <ListBox x:Name="EffectsList" BorderThickness="0" SelectionChanged="EffectsList_SelectionChanged"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox x:Name="RawCheck" Content="Experimental raw mode (unsupported)" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Mode byte:" Width="70" VerticalAlignment="Center"/>
                            <TextBox x:Name="RawModeBox" Text="23" Width="60" TextChanged="RawMode_TextChanged"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Lighting Edit" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                    <TextBlock Text="Color mode" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="MonoRadio" Content="monochrome" IsChecked="True" Margin="0,0,12,0" Checked="Setting_Changed"/>
                        <RadioButton x:Name="RgbRadio" Content="RGB" Checked="Setting_Changed"/>
                    </StackPanel>
                    <TextBlock Text="Lighting Brightness" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <Slider x:Name="Brightness" Minimum="1" Maximum="6" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Width="190" ValueChanged="Setting_Changed"/>
                        <TextBlock x:Name="BrightnessLabel" Text="5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="SpeedPanel">
                        <TextBlock Text="Speed" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Slider x:Name="Speed" Minimum="1" Maximum="6" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Width="190" ValueChanged="Setting_Changed"/>
                            <TextBlock x:Name="SpeedLabel" Text="3" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel x:Name="DirectionPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Direction" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DirectionCombo" Width="160" SelectedIndex="0" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="0 - Left" Tag="0"/>
                            <ComboBoxItem Content="1 - Right" Tag="1"/>
                            <ComboBoxItem Content="2 - Down" Tag="2"/>
                            <ComboBoxItem Content="3 - Up" Tag="3"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="EffectModePanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Effect mode" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EffectModeCombo" Width="160" SelectedIndex="0" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Heart" Tag="0"/><ComboBoxItem Content="Background" Tag="1"/>
                            <ComboBoxItem Content="Both" Tag="2"/><ComboBoxItem Content="Constant" Tag="3"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Musical Rhythm" FontWeight="Bold" FontSize="14" Margin="0,18,0,4"/>
                    <TextBlock Text="Firmware music effects — uses the AJAZZ music plugin, same as the web driver."
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="Display Mode" Margin="0,4,0,2"/>
                    <ComboBox x:Name="MusicModeCombo" SelectedIndex="10" SelectionChanged="MusicSetting_Changed">
                        <ComboBoxItem Content="None" Tag="0"/>
                        <ComboBoxItem Content="Dance to the Beat" Tag="1"/>
                        <ComboBoxItem Content="Dual Heart Dance" Tag="2"/>
                        <ComboBoxItem Content="Dust Glow Spiral" Tag="13"/>
                        <ComboBoxItem Content="Dormant Volcano" Tag="4"/>
                        <ComboBoxItem Content="Light Arrow Piercing" Tag="5"/>
                        <ComboBoxItem Content="Light Cocoon Resonance" Tag="6"/>
                        <ComboBoxItem Content="Tuning Fork Vibration" Tag="7"/>
                        <ComboBoxItem Content="Firefly Trail" Tag="8"/>
                        <ComboBoxItem Content="Curvature Legacy Track" Tag="9"/>
                        <ComboBoxItem Content="Row Wave Rhythm" Tag="11"/>
                        <ComboBoxItem Content="Curvature Frequency Steps" Tag="10"/>
                        <ComboBoxItem Content="Screen light linkage" Tag="100"/>
                    </ComboBox>
                    <TextBlock Text="Amplitude" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="MusicAmplitude" Minimum="1" Maximum="100" Value="50" Width="150" ValueChanged="MusicSetting_Changed"/>
                        <TextBlock x:Name="MusicAmplitudeLabel" Text="50%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Background Lighting Display Mode" Margin="0,8,0,2"/>
                    <ComboBox x:Name="MusicBackModeCombo" SelectedIndex="0" SelectionChanged="MusicSetting_Changed">
                        <ComboBoxItem Content="None" Tag="0"/>
                        <ComboBoxItem Content="White" Tag="6"/>
                        <ComboBoxItem Content="Red" Tag="7"/>
                        <ComboBoxItem Content="Orange" Tag="8"/>
                        <ComboBoxItem Content="Yellow" Tag="9"/>
                        <ComboBoxItem Content="Blue" Tag="10"/>
                        <ComboBoxItem Content="Green" Tag="11"/>
                        <ComboBoxItem Content="Green/Yellow/Red" Tag="1"/>
                        <ComboBoxItem Content="Rainbow" Tag="2"/>
                        <ComboBoxItem Content="Color Spectrum" Tag="4"/>
                    </ComboBox>
                    <TextBlock Text="Background Brightness" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="MusicBackBrightness" Minimum="1" Maximum="100" Value="15" Width="150" ValueChanged="MusicSetting_Changed"/>
                        <TextBlock x:Name="MusicBackBrightnessLabel" Text="15%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="MusicPluginState" Margin="0,6,0,2" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Text="Plugin status: checking…"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="FwMusicApply" Style="{StaticResource AccentButton}" Content="Apply firmware effect" Click="FwMusicApply_Click"/>
                        <Button x:Name="FwMusicStop" Style="{StaticResource GhostButton}" Content="Stop" Margin="8,0,0,0" Click="FwMusicStop_Click"/>
                    </StackPanel>
                    <TextBlock Text="PC-generated rhythm (no plugin required)" FontWeight="Bold" Margin="0,16,0,4"/>
                    <TextBlock Text="Drives the keyboard lighting from system audio amplitude." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MusicStart" Style="{StaticResource GhostButton}" Content="Start PC rhythm" Click="MusicStart_Click"/>
                        <Button x:Name="MusicStop" Style="{StaticResource GhostButton}" Content="Stop" Margin="8,0,0,0" Click="MusicStop_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Color settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="HEX:" Width="40" VerticalAlignment="Center"/>
                        <TextBox x:Name="HexBox" Text="#00FFFF" Width="120" TextChanged="HexBox_TextChanged"/>
                        <Border x:Name="ColorPreview" Width="26" Height="26" Background="#00FFFF" Margin="8,0,0,0" CornerRadius="4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="RGB:" Width="40" VerticalAlignment="Center"/>
                        <TextBox x:Name="RBox" Text="0" Width="52" TextChanged="RgbBox_TextChanged"/>
                        <TextBox x:Name="GBox" Text="255" Width="52" Margin="4,0" TextChanged="RgbBox_TextChanged"/>
                        <TextBox x:Name="BBox" Text="255" Width="52" TextChanged="RgbBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="SecondaryPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="Secondary color" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HEX:" Width="40" VerticalAlignment="Center"/>
                            <TextBox x:Name="HexSecondary" Text="#FFFFFF" Width="120" TextChanged="HexSecondary_TextChanged"/>
                            <Border x:Name="SecondaryPreview" Width="26" Height="26" Background="#FFFFFF" Margin="8,0,0,0" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel x:Name="Swatches" Margin="0,6,0,10"/>
                    <StackPanel x:Name="CustomHint" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Custom (per-key): click a key on the keyboard above to paint it with the current color." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Content="Apply to keyboard" Click="Apply_Click"/>
                        <CheckBox x:Name="LiveCheck" Content="Live update" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="Green" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
